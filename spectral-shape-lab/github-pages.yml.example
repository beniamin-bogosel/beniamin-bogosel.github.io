# Copy to .github/workflows/spectral-pages.yml at the repository root.
# Set Settings > Pages > Source to GitHub Actions, then run this workflow manually.
name: Publish spectral shape app
on:
  workflow_dispatch:
permissions:
  contents: read
  pages: write
  id-token: write
concurrency:
  group: spectral-pages
  cancel-in-progress: false
jobs:
  deploy:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - uses: actions/checkout@v6
      - uses: actions/configure-pages@v5
      - name: Assemble the static app
        run: node web/scripts/build.mjs
      - uses: actions/upload-pages-artifact@v4
        with:
          path: web/dist
      - name: Deploy
        id: deployment
        uses: actions/deploy-pages@v4
